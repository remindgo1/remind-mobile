{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "channel": "dev",
      "environment": "development",
      "env": {
        "APP_ENV": "dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "test",
      "environment": "preview",
      "env": {
        "APP_ENV": "test"
      }
    }
  }
}